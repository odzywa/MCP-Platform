# ──────────────────────────────────────────────────────────────────────────────
# MCP Platform — konfiguracja wdrożenia na Kubernetes / OpenShift
#
# Skopiuj ten plik i wypełnij wartościami swojego klastra:
#     cp config.env.example config.env
#
# config.env jest w .gitignore — nie trafia do repozytorium.
# Plik jest ładowany przez `source`, więc obowiązuje składnia shella:
# bez spacji wokół "=", wartości ze spacjami w cudzysłowach.
# ──────────────────────────────────────────────────────────────────────────────


# ── WYMAGANE ──────────────────────────────────────────────────────────────────
# Bez tych czterech deploy.sh przerwie działanie z komunikatem o brakującej zmiennej.

# Rejestr do PUSH z maszyny, na której uruchamiasz deploy.sh (trasa zewnętrzna).
# Na OpenShifcie to route wbudowanego rejestru + nazwa projektu.
#   oc get route -n openshift-image-registry default-route -o jsonpath='{.spec.host}'
# Jeśli używasz zewnętrznego rejestru (Quay, Harbor, Nexus) — podaj go tutaj.
REGISTRY=default-route-openshift-image-registry.apps.MOJ-KLASTER.example.com/mcp-platform

# Rejestr do PULL z wnętrza klastra — tego adresu używają pody.
# Na OpenShifcie to serwis wewnętrzny rejestru; zwykle różni się od REGISTRY.
# Przy rejestrze zewnętrznym wpisz tu tę samą wartość co w REGISTRY.
PULL_REGISTRY=image-registry.openshift-image-registry.svc:5000/mcp-platform

# Domena aplikacji klastra — z niej powstają hosty Route dla UI i serwerów MCP.
#   oc get ingresses.config cluster -o jsonpath='{.spec.domain}'
APPS_DOMAIN=apps.MOJ-KLASTER.example.com

# Namespace / projekt, w którym wyląduje platforma i wszystkie runtime'y.
# Tworzony automatycznie, jeśli nie istnieje.
NAMESPACE=mcp-platform


# ── STORAGE ───────────────────────────────────────────────────────────────────

# StorageClass dla PVC z bazą SQLite (10Gi, ReadWriteOnce).
#   oc get storageclass
#
# MUSI być block storage. NFS nie zadziała — SQLite w trybie WAL wymaga
# blokad plikowych, których NFS nie obsługuje poprawnie, co kończy się
# uszkodzeniem bazy.
# Przykłady: OpenShift on VMware → thin | AWS → gp3 | LVM Operator → lvms-vg1
# Puste = domyślna StorageClass klastra.
STORAGE_CLASS=


# ── OPCJONALNE: automatyczne wdrożenie serwera MCP do OpenShiftu ──────────────
# Jeśli oba pola są wypełnione, deploy.sh po postawieniu platformy sam
# skonfiguruje i wdroży serwer `openshift-monitor` (20 narzędzi oc/kubectl).
# Zostaw puste, żeby pominąć — możesz to zrobić później z UI.
#
# UWAGA: ten serwer dostaje pełne uprawnienia do klastra. Token trafia do
# Secreta w namespace platformy, a narzędzia write/destructive wymagają
# zatwierdzenia człowieka na stronie /approvals.

# Token ServiceAccountu z uprawnieniami do zarządzania klastrem:
#   oc create sa mcp-admin -n mcp-platform
#   oc adm policy add-cluster-role-to-user cluster-admin -z mcp-admin -n mcp-platform
#   oc create token mcp-admin -n mcp-platform --duration=8760h
OC_MCP_TOKEN=

# Adres API serwera klastra:
#   oc whoami --show-server
OC_MCP_SERVER=
