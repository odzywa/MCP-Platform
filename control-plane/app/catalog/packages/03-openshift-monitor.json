        ],
        "timeout_seconds": 30
      },
      "input_schema": {
        "type": "object",
        "properties": {
          "args": {
            "type": "string",
            "description": "Argumenty komendy oc"
          }
        },
        "required": [
          "args"
        ]
      }
    },
    {
      "name": "oc_adm",
      "description": "Operacje administracyjne — oc adm policy, oc adm top, oc adm prune. Np. policy add-scc-to-user anyuid -z mysa -n ns.",
      "execution_type": "shell",
      "enabled": true,
      "risk_level": "high",
      "mode": "write",
      "category": "openshift",
      "config": {
        "command": [
