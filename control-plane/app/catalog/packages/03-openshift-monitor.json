      },
      "input_schema": {
        "type": "object",
        "properties": {
          "args": {
            "type": "string",
            "description": "Argumenty komendy oc"
          }
        },
        "required": [
          "args"
        ]
      }
    },
    {
      "name": "oc_set",
      "description": "Ustawia właściwości zasobów — env vars, image, resources, volumes.",
      "execution_type": "shell",
      "enabled": true,
      "risk_level": "high",
      "mode": "write",
      "category": "openshift",
      "config": {
        "command": [
          "oc",
          "--token=${OC_TOKEN}",
          "--server=${OC_SERVER}",
          "--insecure-skip-tls-verify",
          "set",
