        ],
        "timeout_seconds": 30
      },
      "input_schema": {
        "type": "object",
        "properties": {
          "args": {
            "type": "string",
            "description": "Argumenty komendy oc"
          }
        },
        "required": [
          "args"
        ]
      }
    },
    {
      "name": "oc_scale",
      "description": "Skaluje deployment/statefulset — zmienia liczbę replik.",
      "execution_type": "shell",
      "enabled": true,
      "risk_level": "high",
      "mode": "write",
      "category": "openshift",
      "config": {
        "command": [
          "oc",
          "--token=${OC_TOKEN}",
          "--server=${OC_SERVER}",
          "--insecure-skip-tls-verify",
          "scale",
          "${*args}"
        ],
        "timeout_seconds": 30
      },
      "input_schema": {
        "type": "object",
        "properties": {
          "args": {
            "type": "string",
            "description": "Argumenty komendy oc"
          }
        },
        "required": [
          "args"
        ]
      }
    },
    {
      "name": "oc_new_app",
      "description": "Tworzy nową aplikację na klastrze — deployment, service i inne zasoby z jednej komendy.",
      "execution_type": "shell",
      "enabled": true,
      "risk_level": "high",
      "mode": "write",
      "category": "openshift",
      "config": {
        "command": [
          "oc",
          "--token=${OC_TOKEN}",
          "--server=${OC_SERVER}",
          "--insecure-skip-tls-verify",
          "new-app",
